#include <bits/stdc++.h>
using namespace std;
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        map<long long, int> freq;
        int mx = 0;
        for (int i = 0; i < n; i++) {
            long long x;
            cin >> x;
            mx = max(mx, ++freq[x]);
        }
        cout << n - mx << '\n';
    }
    return 0;
}
